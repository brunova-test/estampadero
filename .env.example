# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/elestampadero"
# Railway la crea automáticamente al habilitar PgBouncer. Prisma la usa solo
# para migraciones; en desarrollo local puede omitirse.
# DATABASE_UNPOOLED_URL="postgresql://postgres:password@localhost:5432/elestampadero"
# Pool interno por réplica. Si Railway habilita PgBouncer, DATABASE_URL se
# actualizará al endpoint privado del pooler y estos límites seguirán evitando
# que una sola réplica monopolice todas las conexiones.
PRISMA_CONNECTION_LIMIT="10"
PRISMA_POOL_TIMEOUT_SECONDS="15"
# Pedidos sin pago confirmado vencen y devuelven el stock mediante el cron.
UNPAID_ORDER_EXPIRATION_HOURS="24"

# Public base URL, used to build Mercado Pago return/webhook URLs.
APP_URL="http://localhost:3000"

# Comprobantes de compra por email (Resend)
RESEND_API_KEY=""
RECEIPT_EMAIL_FROM="El Estampadero <ventas@tu-dominio.com>"

# Mercado Pago: se usa únicamente para el botón "Pagar con Mercado Pago".
# Access Token y secreto de webhook son privados; nunca llevan NEXT_PUBLIC_.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# Payway homologación: https://api-homo.payway.com.ar/api/v2. Visa/Mastercard
# dentro de la tienda. Sólo la clave
# pública llega al navegador; PRIVATE_API_KEY queda en el servidor. La API v2
# no requiere el antiguo SITE_ID de Decidir.
PAYWAY_ENVIRONMENT="sandbox"
# Opcional/legacy; no se utiliza en la API v2 actual.
PAYWAY_SITE_ID=""
PAYWAY_PRIVATE_API_KEY=""
NEXT_PUBLIC_PAYWAY_ENVIRONMENT="sandbox"
NEXT_PUBLIC_PAYWAY_PUBLIC_API_KEY=""
NEXT_PUBLIC_PAYWAY_INSTALLMENTS="1,3,6"
# Fechas estimadas según el contrato; no confirman el depósito bancario.
PAYWAY_DEBIT_RELEASE_BUSINESS_DAYS=""
PAYWAY_CREDIT_RELEASE_BUSINESS_DAYS=""

# MODO v2. USERNAME/PASSWORD son secretos exclusivos del servidor.
MODO_ENVIRONMENT="sandbox"
MODO_USERNAME=""
MODO_PASSWORD=""
MODO_PROCESSOR_CODE=""
MODO_CC_CODE=""
MODO_MERCHANT_NAME="El Estampadero"

# Authenticates the daily payment-reconciliation cron (GET
# /api/cron/reconcile-payments). The Railway cron service sends this as a
# bearer token when the same-named env var is set in the project — set it
# bearer token. Generate with: openssl rand -hex 32
CRON_SECRET=""

# Required only when intentionally running the seed against production.
SEED_PRODUCTION_CONFIRMATION=""

# Usuarios de prueba creados por `npm run db:seed`.
# Son credenciales de desarrollo: cambiarlas o quitarlas antes de usar el seed
# contra una base de producción. `.env` no se versiona; este bloque sí sirve
# como plantilla para el equipo.
SEED_ADMIN_NAME="Administrador Demo"
SEED_ADMIN_EMAIL="admin@elestampadero.com"
SEED_ADMIN_PASSWORD=""

SEED_CLUB_USER_NAME="Representante Club Atlético"
SEED_CLUB_USER_EMAIL="club@elestampadero.com"
SEED_CLUB_USER_PASSWORD=""
SEED_CLUB_SLUG="club-atletico"

SEED_CUSTOMER_NAME="Cliente Demo"
SEED_CUSTOMER_EMAIL="cliente@elestampadero.com"
SEED_CUSTOMER_PASSWORD=""
# Mobbex Marketplace con Split de Pagos
MOBBEX_API_KEY="zJ8LFTBX6Ba8D611e9io13fDZAwj0QmKO1Hn1yIj"
MOBBEX_ACCESS_TOKEN="d31f0721-2f85-44e7-bcc6-15e19d1a53cc"
MOBBEX_ENTITY_ID="Demo Mobbex"
MOBBEX_TEST_MODE="true"
